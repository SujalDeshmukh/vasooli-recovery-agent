# ─────────────────────────────────────────────────────────────────────────────
# Vasooli — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/vasooli?schema=public"

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
# Redis URL for BullMQ queue backend
REDIS_URL="redis://localhost:6379"

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Webhook secret for HMAC-SHA256 signature validation
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Razorpay API credentials (for retry & mandate APIs — Phase 2)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ── LLM / Right Brain (Phase 2) ──────────────────────────────────────────────
# Google Gemini API key for Hinglish conversational agent
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Messaging (Phase 2) ──────────────────────────────────────────────────────
# WhatsApp Business API (e.g. Twilio or Meta direct)
WHATSAPP_API_URL="https://api.twilio.com/..."
WHATSAPP_AUTH_TOKEN="your_whatsapp_token_here"
WHATSAPP_FROM_NUMBER="+91xxxxxxxxxx"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
